# ScreenDraw server settings.
# Copy this file to ".env" (in the same folder as the launcher) and edit it.
# Lines starting with # are comments. Anything not set uses the default shown.

# ---- Network -----------------------------------------------------------------
# Port the server listens on (and the one to forward on your router).
PORT=8080

# Ask your router to forward PORT automatically (UPnP). 1 = yes, 0 = no.
UPNP=1

# The address friends should use, if you have a domain / dynamic-DNS name or a
# tunnel. Leave empty to detect your public IP automatically.
# "example.com" becomes http://example.com:PORT; write a full URL to be exact.
PUBLIC_URL=

# ---- Access ------------------------------------------------------------------
# Optional password everyone must enter to join any room on this server.
SERVER_PASSWORD=

# ---- Video route ---------------------------------------------------------------
# Default for new shares: "p2p" (direct between computers) or "relay" (sent once
# to this server, which passes it on to every viewer). The sharer can change it.
DEFAULT_MEDIA_MODE=p2p

# Allow shares to be relayed through this server at all. 1 = yes, 0 = no.
ALLOW_RELAY=1

# STUN/TURN servers for direct (P2P) connections, comma-separated.
# A TURN server helps friends on strict networks (work, school, some mobile).
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Limits ------------------------------------------------------------------
MAX_ROOMS=200
MAX_PER_ROOM=20
# Largest sticker image accepted, in KB.
MAX_STICKER_KB=400

# Fallback connection (used only when WebSockets are blocked), in milliseconds.
POLL_HOLD_MS=25000
MEMBER_TIMEOUT_MS=35000
